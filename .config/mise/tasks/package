#!/usr/bin/env bash
#MISE description="Build the package.el archive target/package/jvm-<version>.tar"
# The archive holds the module for the host platform only. Install it with
# M-x package-install-file.
set -euo pipefail

cargo build --release

PKGID="$(cargo pkgid)"
VERSION="${PKGID##*[#@]}"
# Cargo names the cdylib like this; jvm.el's `jvm--module-file' expects the same name.
SUFFIX="$(emacs -Q --batch --eval '(princ module-file-suffix)')"
case "$SUFFIX" in
    .dll) MODULE="emacs_jni$SUFFIX" ;;
    *) MODULE="libemacs_jni$SUFFIX" ;;
esac

OUT_DIR=target/package
PKG_DIR="$OUT_DIR/jvm-$VERSION"
rm -rf "$PKG_DIR"
rm -f "$OUT_DIR"/jvm-*.tar
mkdir -p "$PKG_DIR"
cp elisp/jvm.el elisp/jvm-clj.el "target/release/$MODULE" "$PKG_DIR/"
cp -r clojure-src "$PKG_DIR/"
cat > "$PKG_DIR/jvm-pkg.el" <<PKG
;; Generated by the mise package task  -*- no-byte-compile: t; lexical-binding: t -*-
(define-package "jvm" "$VERSION"
  "Embed a JVM in Emacs; call Java and Clojure from Lisp"
  '((emacs "28.1")))
PKG
tar -cf "$OUT_DIR/jvm-$VERSION.tar" -C "$OUT_DIR" "jvm-$VERSION"
echo "$OUT_DIR/jvm-$VERSION.tar"
